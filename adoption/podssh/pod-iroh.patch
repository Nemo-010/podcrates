-    A: AsyncRead + AsyncWrite + Unpin + Send + 'static,
-    O: Fn() -> F + Clone + Send + Sync + 'static,
-    F: Future<Output = Result<A, String>> + Send + 'static,
-    G: Fn(&PublicKey) -> bool + Clone + Send + Sync + 'static,
