-/// Bridges axum's [`WebSocket`] to iroh-relay's [`BytesStreamSink`].
-struct AxumWebSocketAdapter {
-    inner: Pin<Box<WebSocket>>,
-}
-
-impl AxumWebSocketAdapter {
