-            Ok(Err(e)) if connect_refused(&e) => Err(Failure::Refused),
-            Ok(Err(e)) => Err(Failure::Failed(format!("no connection to the node: {e}"))),
-            Err(_) => Err(Failure::Failed(format!("no connection to the node within {} s", limit.as_secs()))),
