-                tokio::select! {
-                    _ = interval.tick() => {
-                        let _ = _reloadable.reload().await;
-                        tracing::info!("Reloaded the certificate");
-                    },
-                    _ = _cancel_token.cancelled() => {
-                        tracing::trace!("shutting down");
-                        break;
-                    }
-                }
-            }
-        });
-        let _handle = AbortOnDropHandle::new(_handle);
