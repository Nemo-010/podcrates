-            && label.len() <= MAX_LABEL
-            && !label.starts_with('-')
-            && !label.ends_with('-')
-            && label.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
-    });
-    match good {
-        true => Ok(name),
-        false => Err(format!("its quick tunnel is not one name under {}, and is set aside", quick_zone())),
-    }
