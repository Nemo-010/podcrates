-                return ("409 Conflict", b"a newer record is kept".to_vec());
-            }
-            records.insert(key, request.body.clone());
-            ("204 No Content", Vec::new())
-        }
-        _ => ("405 Method Not Allowed", Vec::new()),
-    }
-}
