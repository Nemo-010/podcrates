-/// Handles the client side of QUIC address discovery.
-#[derive(Debug, Clone)]
-pub struct QuicClient {
-    /// A QUIC Endpoint.
-    ep: noq::Endpoint,
-    /// A client config.
-    client_config: noq::ClientConfig,
