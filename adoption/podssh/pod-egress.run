# The trial of pod-egress in podssh (T-035, part 1; calls C616 to C620), at
# podssh's main 2ffb7cd7 (pod-egress.commit), where podssh froze the roads
# of podssh-ws for the move (its T-684, Q101; PodUtils/podssh#248).
# podssh-ws's via/, forwarder/, wstunnel/, wisp/, meek/, meek.rs,
# webtunnel.rs, pt.rs and cloudflare.rs become modules of glue over
# pod-egress (pub use pod_egress::ROAD::*, and podssh's way out for a
# ProxyChoice: via::dial, forwarder::dial, forwarder::note,
# forwarder::silent, wstunnel::dial, wisp::connect_with, pt::reach,
# cloudflare::connect); chisel, upterm, shadowsocks and vless take the
# shared carrier and a silent note; vless takes pod-ws's h2_road::duplex;
# podssh-cli and podssh-tor take the glue functions and builtin(). The
# tests via, forwarder, live_forwarder, meek, webtunnel, wisp (with
# wisp_support), wstunnel and cloudflare_access, forwarder-live.yml and the
# plants t438, t439 and t441 leave podssh. Each podcrates tag moves to
# v0.51.0. The steps: the record with its citations, the repository checks;
# no moved file stays; pod-egress in the tree; clippy and the tests of
# podssh-ws with each feature; clippy of the CLI and of the Tor road; the
# CLI's unit tests of the roads and its tests of the forwarders and of the
# Cloudflare road; the Tor road's unit tests; rustfmt of the changed
# crates; each Rust toolchain of the workflows against the rust-version of
# podcrates; each test target that the gate names.
cargo run -q -p podssh-todo -- remap Cargo.lock > /dev/null
cargo run -q -p podssh-todo -- check
python3 scripts/check-repo.py
test ! -e crates/podssh-ws/src/via && test ! -e crates/podssh-ws/src/forwarder && test ! -e crates/podssh-ws/src/wstunnel && test ! -e crates/podssh-ws/src/wisp && test ! -e crates/podssh-ws/src/meek
test ! -e crates/podssh-ws/tests/wisp_support && test ! -e crates/podssh-ws/tests/via.rs && test ! -e crates/podssh-ws/tests/cloudflare_access.rs && test ! -e .github/workflows/forwarder-live.yml && test ! -e scripts/plants/t438-wisp-credit.plant
cargo tree -q -p podssh-ws -i pod-egress | grep -q '^pod-egress v'
cargo clippy -q --all-targets -p podssh-ws --all-features -- -D warnings -A clippy::collapsible_if
cargo test -q -p podssh-ws --all-features
cargo clippy -q --all-targets -p podssh-cli -- -D warnings -A clippy::collapsible_if
cargo clippy -q --all-targets -p podssh-tor --all-features -- -D warnings -A clippy::collapsible_if
cargo test -q -p podssh-cli --lib -- forwarder via wstunnel cloudflare
cargo test -q -p podssh-cli --test forwarder_cli --test forwarder_public --test cloudflare_cli
cargo test -q -p podssh-tor --lib
cargo fmt -p podssh-ws -p podssh-cli -p podssh-tor --check
python3 -I "$PODCRATES/scripts/check-consumer-toolchains.py"
python3 -I "$PODCRATES/scripts/check-consumer-tests.py"
