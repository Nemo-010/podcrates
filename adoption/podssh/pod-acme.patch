-/// The type of each JWS POST (RFC 8555, section 6.2).
-const JOSE: &str = "application/jose+json";
-/// The type of a chain of certificates (RFC 8555, section 9.1).
-pub const PEM_CHAIN: &str = "application/pem-certificate-chain";
