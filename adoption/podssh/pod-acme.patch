-/// An answer of the CA, or why none came.
-pub type Answer = Result<Response, String>;
-
-/// How the CA is reached.
-#[derive(Debug, Clone)]
-pub struct Http {
-    pub trust: Trust,
-    pub proxy: ProxyChoice,
-    /// The limit of the connection and of each answer.
-    pub timeout: Duration,
-}
