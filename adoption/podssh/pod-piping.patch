-impl Server {
-    /// `https://HOST[:PORT][/PREFIX]`, with or without a `/` at its end. A
-    /// user, a query or a fragment is refused: a Piping Server reads the
-    /// path alone, and a `?n=` would change who meets.
-    pub fn parse(text: &str) -> Result<Server, String> {
