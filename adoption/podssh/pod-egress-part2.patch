-            Ok(None) => (Vec::new(), None),
-            Err(Waited::Silent(ended)) => return Err(OpenError::Silent { ended, after: wait, proxy }),
-            Err(Waited::Chunk(e)) => return Err(OpenError::Chunk(e)),
