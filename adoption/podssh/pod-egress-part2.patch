-        match self {
-            Spec::Chacha(c) => c.decrypt(&chacha20poly1305::Nonce::from(nonce), sealed).ok(),
-            Spec::Aes256(c) => c.decrypt(&gcm, sealed).ok(),
-            Spec::Aes128(c) => c.decrypt(&gcm, sealed).ok(),
-        }
-    }
-}
