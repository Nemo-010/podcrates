-impl Again {
-    /// What `dial` holds for `server`, owned.
-    pub fn of(server: &Server, dial: &super::Dial<'_>) -> Again {
-        Again { server: server.clone(), trust: dial.trust.clone(), proxy: dial.proxy.clone(), timeout: dial.timeout }
-    }
