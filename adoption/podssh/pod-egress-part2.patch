-/// What a response's head said.
-#[derive(Debug, Clone, Copy, PartialEq, Eq)]
-pub(super) struct Answer {
-    pub status: u16,
-    pub body: Framing,
-    /// The server closes the connection after this response.
-    pub close: bool,
