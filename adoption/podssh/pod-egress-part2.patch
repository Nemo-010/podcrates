-impl Chunks {
-    pub fn new(cipher: Cipher, key: &[u8; 16], iv: &[u8; 16]) -> Option<Chunks> {
-        Some(Chunks { aead: cipher.aead(key)?, iv: *iv, count: 0 })
-    }
