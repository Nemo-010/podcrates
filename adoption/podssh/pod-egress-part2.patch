-/// A session to the target.
-pub struct Opened {
-    pub stream: Box<dyn Duplex>,
-    /// What carried it: "a WebSocket over TLS", "a WebSocket".
-    pub how: &'static str,
-    /// The server's answer came within the wait.
-    pub answered: bool,
