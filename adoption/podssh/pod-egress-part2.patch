-
-/// The plaintext of the server's first chunk within `wait`; `None` when it
-/// was silent and `silence_is_ready`.
-async fn first_chunk<S: AsyncRead + Unpin>(
-    stream: &mut S,
-    decoder: &mut Decoder,
-    wait: Duration,
-    silence_is_ready: bool,
-) -> Result<Option<Vec<u8>>, Waited> {
