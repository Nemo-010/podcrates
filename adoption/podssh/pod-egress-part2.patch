-/// Random bytes from the system's source.
-fn fill(out: &mut [u8]) -> Result<(), VmessError> {
-    use rustls::crypto::SecureRandom as _;
-    crate::crypto::random::OsRandom.fill(out).map_err(|_| VmessError::Carry("no random bytes".into()))
-}
