-    fn nonce(&mut self) -> [u8; NONCE_LEN] {
-        let mut nonce = [0u8; NONCE_LEN];
-        nonce.copy_from_slice(&self.iv[..NONCE_LEN]);
-        nonce[..2].copy_from_slice(&self.count.to_be_bytes());
-        // Go's count of 16 bits wraps, and so does this one.
