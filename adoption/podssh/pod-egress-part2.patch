-    pub headers: Vec<(String, String)>,
-    /// The range of the padding's length.
-    pub padding: (u32, u32),
-    /// No `Content-Type: application/grpc` on a streamed upload.
-    pub no_grpc_header: bool,
-    /// The largest body of one POST of packet-up.
-    pub max_post: usize,
