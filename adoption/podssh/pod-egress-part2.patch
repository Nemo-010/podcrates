-async fn line<R: AsyncRead + Unpin>(conn: &mut BufReader<R>, max: usize) -> io::Result<String> {
-    let mut bytes = Vec::new();
-    let n = (&mut *conn).take(max as u64 + 2).read_until(b'\n', &mut bytes).await?;
-    if n == 0 {
