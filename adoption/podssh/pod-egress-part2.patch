-        let chunk = data.split_to(room.min(data.len()));
-        send.send_data(chunk, false).map_err(|e| format!("HTTP/2: {e}"))?;
-    }
-    if end {
-        send.send_data(Bytes::new(), true).map_err(|e| format!("HTTP/2: {e}"))?;
-    }
-    Ok(())
-}
