-/// How a stand-in answers.
-#[derive(Clone, Copy, PartialEq)]
-enum Answer {
-    /// As wstunnel 10 and 11: the tunnel, or 400 "Invalid request".
-    Tunnel,
-    /// As wstunnel 9: 400 "Invalid upgrade request".
