-/// `dial` names, TLS for `wss://` checked for the server's name, the
-/// upgrade with the token and the secret, then the bytes in binary frames.
-pub async fn open(
-    server: &Server,
-    secret: &Secret,
-    host: &str,
-    port: u16,
-    dial: &Dial<'_>,
