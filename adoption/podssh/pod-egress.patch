-async fn open(server: &Server, secret: &Secret, aim: u16) -> Result<wstunnel::Carried, WstunnelError> {
-    tokio::time::timeout(LIMIT * 2, wstunnel::open(server, secret, "127.0.0.1", aim, &dial()))
-        .await
