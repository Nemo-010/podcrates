-fn dial() -> Dial<'static> {
-    static TRUST: Trust = Trust::Default;
-    static PROXY: ProxyChoice = ProxyChoice::Direct;
-    Dial { trust: &TRUST, proxy: &PROXY, timeout: LIMIT, at_end: AtEnd::Now }
