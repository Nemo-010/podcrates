-    // wait for, and a text frame, which it never sends, would be a note.
-    let note: crate::forwarder::Note = std::sync::Arc::new(|_: &str| {});
-    let (carried, _first) = carry::spawn(session, Form::Query, dial.at_end, note, PEER);
-    Ok(carried)
-}
