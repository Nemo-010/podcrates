-        if credit.has_changed().unwrap_or(false) {
-            left = *credit.borrow_and_update();
-        }
-        while left == 0 {
-            tokio::select! {
-                changed = credit.changed() => match changed {
-                    Ok(()) => left = *credit.borrow_and_update(),
-                    Err(_) => return,
-                },
-                () = ended(&mut word) => return,
