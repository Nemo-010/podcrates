-fn how(notes: &Notes) -> Connect<'static> {
-    let kept = notes.clone();
-    let note = Arc::new(move |text: &str| kept.lock().unwrap().push(text.to_string()));
-    Connect { trust: &TRUST, proxy: &PROXY, timeout: LIMIT, note }
-}
