-                slot.credit.send_replace(left);
-            }
-        }
-        (id, Packet::Close(reason)) => {
-            shared.finish(id, End::Closed(reason));
-        }
-        (_, other) => (shared.note)(&format!("the Wisp server sent {}, which a client does not take", other.name())),
-    }
-    None
-}
