-    }
-    let confirm = server.extension(ext::CONFIRM).is_some();
-    if confirm {
-        extensions.push(Extension { id: ext::CONFIRM, payload: Vec::new() });
-    }
-    let ours = Info { major: version.0, minor: version.1, extensions };
-    let motd = motd.filter(|m| !m.is_empty());
