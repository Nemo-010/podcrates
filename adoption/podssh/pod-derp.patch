-    queue: VecDeque<Segment>,
-    next: u64,
-    acked: u64,
-    /// Sends so far, which order them; and the latest send that arrived.
-    sends: u64,
-    delivered: u64,
-    window: f64,
-    threshold: f64,
-    /// No other reduction of the window until this segment is acknowledged.
-    recover: u64,
-    peer_window: u64,
