-/// A ticket in a message: its start, as it may be long.
-fn shown(text: &str) -> String {
-    let text = podssh_ws::text::one_line(text);
-    match text.char_indices().nth(24) {
-        Some((cut, _)) => format!("{}...", &text[..cut]),
-        None => text,
-    }
-}
