-pub type Dialing = Pin<Box<dyn Future<Output = Result<BoxIo, String>> + Send>>;
-/// How to reach a server: TLS through the proxy ([`tls`]), or a test's pipe.
-pub type Dial = Arc<dyn Fn(&Server) -> Dialing + Send + Sync>;
