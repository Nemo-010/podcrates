-/// A client of Tor, bootstrapped; a clone shares it.
-#[derive(Clone)]
-pub struct Tor {
-    pub(crate) client: Arc<TorClient<Runtime>>,
-}
-
-impl Tor {
-    /// Make the client and bootstrap it, within `wait`: Arti fetches what it
