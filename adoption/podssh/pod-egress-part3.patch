-/// Both directions on `link`, until one ends.
-async fn carry<S>(
-    link: &RelaySession<S>,
-    from_ssh: &mut ReadHalf<DuplexStream>,
-    to_ssh: &mut WriteHalf<DuplexStream>,
-    flow: &Mutex<Flow>,
