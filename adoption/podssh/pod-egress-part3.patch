-        assert_eq!(flow.ack(), Some(2 * MAX_DATA as u64 + 1));
-        assert!(!flow.ack_due());
-        assert_eq!(flow.ack(), None);
-        flow.delivered(5);
-        assert_eq!(flow.ack(), Some(2 * MAX_DATA as u64 + 6));
