-pub(crate) fn session<S>(stream: S, pending: Vec<u8>) -> RelaySession<S>
-where
-    S: AsyncRead + AsyncWrite,
-{
-    RelaySession::new(stream, pending, None, WRITE_TIMEOUT).without_pings()
-}
