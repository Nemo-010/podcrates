-        assert_eq!(fate(Some(4033)), Fate::Fail(Why::NotAuthorized));
-        assert_eq!(fate(Some(4003)), Fate::Fail(Why::Backend));
-        assert_eq!(fate(Some(4047)), Fate::Fail(Why::Lookup));
-        assert_eq!(fate(Some(4051)), Fate::Fail(Why::Lookup));
