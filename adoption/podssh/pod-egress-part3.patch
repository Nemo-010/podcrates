-        Err(Unopened::Closed { code, reason }) => return Err(NotOpen::Closed { code, reason }),
-        Err(Unopened::Silent) => return Err(NotOpen::Silent(wait)),
-        Err(Unopened::Fault(why)) => return Err(NotOpen::Fault(why)),
