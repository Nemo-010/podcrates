-                Ok(Ok(())) => {}
-                Ok(Err(_)) => break,
-                Err(_) => {
-                    debug!(
-                        "the origin read nothing for {} s; the stream fails",
-                        WRITE_STALL.as_secs()
-                    );
-                    break;
-                }
