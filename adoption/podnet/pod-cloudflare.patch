-impl Credentials {
-    /// Parse a tunnel UUID into its 16 raw bytes, which is how it goes on the
-    /// wire (`tunnelId :Data`).
-    pub fn tunnel_id_bytes(&self) -> Result<[u8; 16], String> {
-        parse_uuid(&self.tunnel_id)
-    }
