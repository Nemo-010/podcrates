-/// Decode a `ConnectResponse` root: the error text and the metadata.
-pub fn decode_connect_response(root: &StructReader<'_>) -> Result<(String, Vec<(String, String)>)> {
-    Ok((root.get_text(0)?, read_metadata(root, 1)?))
