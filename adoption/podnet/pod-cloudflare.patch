-    match tokio::time::timeout(HANDSHAKE_TIMEOUT, connecting).await {
-        Ok(Ok(conn)) => Ok(conn),
-        Ok(Err(e)) => Err(anyhow::anyhow!("QUIC handshake with {socket}: {e}")),
-        Err(_) => Err(anyhow::anyhow!("QUIC handshake with {socket} timed out")),
-    }
-}
