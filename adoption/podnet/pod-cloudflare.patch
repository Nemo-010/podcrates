-                Ok(answer) => answer,
-                Err(err) => {
-                    tracing::debug!(%target, rtype, %err, "address lookup failed");
-                    continue;
-                }
-            };
-            for entry in &answer.records {
-                if entry.kind != *wanted {
-                    continue;
-                }
-                let Ok(ip) = entry.data.trim().parse::<IpAddr>() else {
-                    continue;
-                };
