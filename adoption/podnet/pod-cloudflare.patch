+pub fn code_of_class(class: pod_core::Class) -> i32 {
+    match i32::from(class.exit_code()) {
+        code @ (USAGE | NO_INPUT | UNAVAILABLE | TEMPFAIL | NO_PERM | CONFIG) => code,
+        _ => FAILURE,
+    }
