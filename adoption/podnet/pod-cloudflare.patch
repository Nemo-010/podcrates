-    .map_err(|e| {
-        crate::hop::at(
-            crate::hop::tls_hop(&e),
-            anyhow::anyhow!("TLS with the edge at {addr}: {}", crate::hop::tls_text(&e)),
-        )
-    })?;
-
-    register_served(
-        addr, tls, auth, tunnel_id, conn_index, options, runtime, ingress, budget,
-    )
-    .await
