-/// One edge address (port 7844 in normal use).
-#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
-pub struct EdgeAddr {
-    pub ip: std::net::IpAddr,
-    pub port: u16,
-    pub version: EdgeIpVersion,
-    /// The index of the SRV target (region1 is 0, region2 is 1); 0 when
-    /// unknown.
-    pub region: u8,
-}
