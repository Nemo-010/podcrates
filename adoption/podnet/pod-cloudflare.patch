-    let mut head = String::with_capacity(256);
-    head.push_str(method);
-    head.push(' ');
-    head.push_str(&path);
-    head.push_str(" HTTP/1.1\r\n");
-    if !host.is_empty() {
-        head.push_str("Host: ");
-        head.push_str(&host);
-        head.push_str("\r\n");
