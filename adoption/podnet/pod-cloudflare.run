# The trial of pod-cloudflare in podnet (T-029). podnet's Cloudflare tunnel
# (src/cloudflare/, src/tunnel/, the quick tunnels, the configuration file,
# the edge discovery, the HTTP/2 leg, the edge side of the proxy and of the
# forward WebSocket, the race, the counters, the UDP probe, the ingress
# rules and the dial of an origin) goes onto pod-cloudflare. podnet keeps
# the glue: src/tunnel.rs gives the crate its host (the TLS context, the
# egress, the resolver with the pins, the system SRV records, the relay of
# --transport relay, the WARP device of --warp-identity, the log and the
# counters of the decisions, the settings from PODNET_EDGE, PODNET_UDP,
# PODNET_VERIFY_STRICT and the budget of a detached start, podnet's words);
# src/proxy.rs serves podnet's services (the static files, the file server,
# git, the shares and the PIN gate) through ServiceDispatch; the origin dial
# takes podnet's own configuration of noTLSVerify. The tests of the command
# line run against the stand-in of the crate (feature standin). The
# webpki-roots of the lock moves to the version of the pod-tls of the tree.
# The record of podnet (the citations of the changed files move, the
# citations of the moved code name the commit before the cut), the size and
# the layers of the files, the build, the bans and the sources of
# cargo-deny, pod-cloudflare in the tree, no moved file and no copy of a
# moved item left in podnet, clippy of the workspace, the tests of the
# libraries, the tests of the tunnel, of the trust, of the egress, of the
# signals, of the doctor and of the services, the library surface, the rule
# words, the docs, the commands, the tests of the CLI and of the binary,
# the fuzz targets with their lock, rustfmt, each Rust toolchain of the
# workflows and build images against the rust-version of podcrates, and the
# binary for x86_64 musl, built with zig (a debug build: the release profile
# takes LTO), with podnet's static check of it.
cargo update -q -p webpki-roots --precise "$(sed -n 's/^pub const ROOTS_VERSION: &str = "\(.*\)";/\1/p' "$PODCRATES/crates/pod-tls/src/trust.rs")"
cargo run -q -p podnet-todo -- remap $(git diff --name-only --diff-filter=M -- . ':!TODO') > /dev/null
cargo run -q -p podnet-todo -- check
python3 scripts/check-size.py
python3 scripts/check-layers.py
cargo build -q
command -v cargo-deny > /dev/null || cargo install -q --locked cargo-deny
cargo deny --locked check bans sources
cargo tree -q -p podnet -i pod-cloudflare | grep -q '^pod-cloudflare v'
for f in src/cloudflare src/tunnel src/quicktunnel src/config tests/standin/api.rs tests/standin/ca.rs tests/standin/edge.rs tests/standin/front.rs tests/standin/proxy.rs tools/check-header-oracle.sh tools/header-oracle.txt; do test ! -e "$f" || exit 1; done
! git grep -n -E "struct Message\b|fn serve_connection|fn register_connection|struct TunnelBuilder|fn request_quick_tunnel|fn discover_doh|fn discover_system|fn checked_targets|struct EdgeAddr|fn decode_origin_response|fn build_request_head|fn forward_tcp|fn forward_http|fn serve_websocket|enum Failover|pub async fn race|struct MetricsSnapshot|fn parse_srv|pub struct Ingress\b|fn ingress_from_raw|struct ConnectRequest|fn encode_connect_request|fn plan_with_udp|fn plan_with_proxy|enum LegKind|struct WarpLink|fn verify_fetch|fn parse_token|fn load_file|fn futures_write_all|fn copy_chunked_to_futures|fn read_response_head|fn validate_quick_hostname|fn authority_of|struct Refused \{|fn connect_origin|fn parse_http_url|fn local_name|struct QuickTunnel\b|fn parse_retry_after|fn tls_wrap|fn dial_unix|struct Counted<'a>" -- src crates tests
cargo clippy -q --workspace --all-targets -- -D warnings
cargo test -q -p podnet --lib
cargo test -q -p podnet-core -p podnet-serve
cargo test -q -p podnet --test quick_tunnel_standin --test tunnel_config --test tls --test egress --test signals --test doctor --test service_serve_ingress
cargo test -q -p podnet --test api_surface --test rule_words --test docs --test commands
cargo test -q -p podnet --test cli
cargo test -q -p podnet --bin podnet
cargo update -q -w --manifest-path fuzz/Cargo.toml
cargo check -q --manifest-path fuzz/Cargo.toml --bins
cargo fmt --all --check
python3 -I "$PODCRATES/scripts/check-consumer-toolchains.py"
cargo zigbuild -q --target x86_64-unknown-linux-musl -p podnet --bin podnet
sh scripts/check-static.sh "${CARGO_TARGET_DIR:-target}/x86_64-unknown-linux-musl/debug/podnet"
