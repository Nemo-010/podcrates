# One byte past the window of the link ends the link.
role: listener
settings: stream_window=16384 link_window=16384
rules: W-18 W-24
class: credit
send Open(1)
send Open(3)
send Data(1, 61*16384)
send Data(3, 01)
expect-end Protocol("1 bytes on the stream 3, past the window of the link")
expect GoAway(1)
expect-eof
