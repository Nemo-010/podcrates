# The peer opens a stream and the end opens one; bytes go both ways.
role: listener
rules: W-09 W-10 W-12 W-17 W-18
class: streams
expect Window(0, 8372224)
send Open(1)
send Data(1, 6869)
accept 1
read 1 2
write 1 2
expect Data(1, 6161)
open 2
write 2 3
expect Open(2)
expect Data(2, 616161)
send Data(2, 01)
read 2 1
expect-quiet
