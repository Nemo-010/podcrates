# pod-manual: the probe of requires keeps the help of a command with no argument, so a probe with no flag fails; the test of the rules of requires must fail.
ENTRY=T-726
GROUP=manual
EXPECT='test the_reader_gives_each_rule_of_requires \.\.\. FAILED'
RUN='cargo test -p pod-manual --all-features --test clap -- the_reader_gives_each_rule_of_requires --exact'
