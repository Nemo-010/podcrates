# An endpoint's refusal that quotes the request goes back as it came: the
# test of a refusal must find the key, the token and the URL in its words.
ENTRY=T-035
GROUP=egress
EXPECT='test an_eice_refusal_is_a_typed_failure_and_shows_no_credential \.\.\. FAILED'
RUN='cargo test -p pod-egress --all-features --test eice -- an_eice_refusal_is_a_typed_failure_and_shows_no_credential'
