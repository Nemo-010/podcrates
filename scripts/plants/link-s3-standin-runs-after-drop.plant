# The stand-in of the S3 API serves on after its drop: its port and its
# connections stay open, and a thread of it runs to the end of the
# process (T-627).
ENTRY=T-627
GROUP=link
EXPECT='a drop closes each connection of the stand-in'
RUN='cargo test -p pod-link --all-features --test s3_standin a_drop'
LIMIT=1800
