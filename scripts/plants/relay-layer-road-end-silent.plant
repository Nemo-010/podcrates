# pod-relay: a link of the road that failed ends as a clean end, so the layer reads no cause; the unit test of the end of a road link must fail (T-801, PodUtils/podssh#287).
ENTRY=T-801
GROUP=relay
EXPECT='a_road_link_ends_with_the_words_of_its_road'
RUN='cargo test -p pod-relay --all-features --lib a_road_link_ends_with_the_words_of_its_road'
LIMIT=1800
