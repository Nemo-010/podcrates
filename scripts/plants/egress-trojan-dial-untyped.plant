# A Trojan server's fallback (its refusal of the password) is a fault of the
# protocol, not a refusal: the test of the road as a dialer must fail.
ENTRY=T-035
GROUP=egress
EXPECT='test a_trojan_road_is_a_dialer_and_a_wrong_password_is_a_typed_failure \.\.\. FAILED'
RUN='cargo test -p pod-egress --all-features --test trojan -- a_trojan_road_is_a_dialer_and_a_wrong_password_is_a_typed_failure'
