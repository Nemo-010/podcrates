# An OK false of a Nostr relay is dropped: the end waits for its own event
# until the limit and fails with no words of the relay; the test of a
# relay that refuses must fail.
ENTRY=T-550
GROUP=wormhole
EXPECT='test a_relay_that_refuses_is_passed_over_with_its_words \.\.\. FAILED'
RUN='cargo test -p pod-wormhole --features standin --test nostr -- a_relay_that_refuses_is_passed_over_with_its_words --exact'
