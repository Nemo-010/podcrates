# pod-manual: the model check does not hold the exit code of a feature or of a flag not in this release to EXIT STATUS; the test of the model check must fail (T-807, PodUtils/podssh#288).
ENTRY=T-807
GROUP=manual
EXPECT='the_model_check_holds_the_new_forms'
RUN='cargo test -p pod-manual --all-features --lib sections::tests'
LIMIT=1800
