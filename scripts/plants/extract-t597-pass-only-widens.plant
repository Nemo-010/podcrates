# The permission pass sets only the directories that it widens, so the
# umask cuts the mode of a directory in the tree between two layers
# (T-597). The pass after the last layer sets the mode again, so the test
# checks the tree between two layers (T-678).
ENTRY=T-597
GROUP=extract
EXPECT='the umask changed the mode of d:'
RUN='cargo test -p pod-extract --all-features --lib drive::umask'
LIMIT=1800
