# The path prefix of the secret is not sent; the client sends wstunnel's
# default prefix, and the stand-in server, which restricts the prefix,
# refuses the tunnel with its 400: the test of the secret must fail with the
# refusal said in the words of wstunnel 10 and later (podssh's plant
# t441-wstunnel-wrong-secret).
ENTRY=T-035
GROUP=egress
EXPECT='Refused \{ status: 400, words: "Invalid request; the words of wstunnel 10 and later'
RUN='cargo test -p pod-egress --all-features --test wstunnel -- the_secret_goes_in_the_path_and_a_wrong_one_is_refused_in_its_words'
