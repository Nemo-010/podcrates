# pod-enter: the overlay of the rung in a user namespace has no userxattr,
# so it reads no opaque directory on a kernel with no patch of its own. The
# unit test of the attempts of the mount must fail: a kernel of Ubuntu
# reads the opaque directory and shows userxattr with no such option, so
# the live test of the upper layer cannot catch it there.
ENTRY=T-755
GROUP=enter
EXPECT='the first try in a user namespace has userxattr'
RUN='cargo test -p pod-enter --lib the_mount_in_a_user_namespace_tries_userxattr_first'
