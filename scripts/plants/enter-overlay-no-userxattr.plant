# pod-enter: the overlay of the rung in a user namespace has no userxattr,
# so it reads no opaque directory; the live test of the upper layer must
# fail where the payload sees a file under an opaque directory.
ENTRY=T-755
GROUP=enter
EXPECT='the payload sees a file under an opaque directory as a caller with no capabilities'
RUN='sh scripts/ci/userns-tests.sh'
LIMIT=1800
