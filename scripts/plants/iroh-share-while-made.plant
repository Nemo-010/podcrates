# A second session of the process shares the node's dialer only while the
# first is still making it, so a copy beside a terminal that is already
# connected makes an endpoint and a connection of its own: the test of two
# sessions on one connection must fail (podssh's t666-share-while-made).
ENTRY=T-037
GROUP=link
EXPECT='test two_sessions_of_one_process_share_one_connection_on_two_streams \.\.\. FAILED'
RUN='cargo test -p pod-iroh --all-features --test share -- two_sessions_of_one_process_share_one_connection_on_two_streams'
