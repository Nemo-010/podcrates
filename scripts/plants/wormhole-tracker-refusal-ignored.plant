# A failure reason of a tracker is not a refusal: an end waits out the
# answer limit and does not say the tracker's words; the test of a tracker
# that refuses must fail.
ENTRY=T-551
GROUP=wormhole
EXPECT='test a_tracker_that_refuses_or_says_nothing_is_passed_over_with_its_words \.\.\. FAILED'
RUN='cargo test -p pod-wormhole --features standin --test tracker -- a_tracker_that_refuses_or_says_nothing_is_passed_over_with_its_words --exact'
