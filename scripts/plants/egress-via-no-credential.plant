# The credential of the second proxy is left out of each CONNECT, on
# HTTP/1.1 and on HTTP/2; the stand-in proxy answers 407, and the test of
# the credential must fail with the 407 said in its words (podssh's plant
# t439-via-no-credential).
ENTRY=T-035
GROUP=egress
EXPECT='refused CONNECT 127\.0\.0\.1:[0-9]+: 407 Proxy Authentication Required; it asks for Basic'
RUN='cargo test -p pod-egress --all-features --test via -- the_credential_goes_with_each_connect_and_a_407_says_what_is_missing'
