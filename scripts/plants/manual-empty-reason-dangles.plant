# pod-manual: an empty reason of an ignored flag writes "Accepted and ignored:" with nothing after it; the test of each kind of flag must fail (T-807, PodUtils/podssh#288).
ENTRY=T-807
GROUP=manual
EXPECT='each_kind_of_flag_has_its_sentence'
RUN='cargo test -p pod-manual --all-features --lib sections::tests'
LIMIT=1800
