# The tag of each code at a Nostr relay is one constant, not the topic of
# its nameplate: a taker of another code meets the giver; the test of an
# event with the tag of another code must fail.
ENTRY=T-550
GROUP=wormhole
EXPECT='test an_event_with_the_tag_of_another_code_is_not_delivered \.\.\. FAILED'
RUN='cargo test -p pod-wormhole --features standin --test nostr -- an_event_with_the_tag_of_another_code_is_not_delivered --exact'
