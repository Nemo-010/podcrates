# The client never offers the ALPN stun.turn; the test of the ALPN
# against the mock must fail.
ENTRY=T-381
GROUP=turn
EXPECT='test (.*::)?the_alpn_stun_turn_is_offered_when_asked \.\.\. FAILED'
RUN='cargo test -p pod-turn --all-features --test turn_redirect -- the_alpn_stun_turn_is_offered_when_asked --exact'
LIMIT=1800
