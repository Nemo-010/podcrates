# A Shadowsocks server that says nothing within the wait is an unavailable
# server, not a timeout: the test of the road as a dialer must fail.
ENTRY=T-035
GROUP=egress
EXPECT='test a_shadowsocks_road_is_a_dialer_and_a_silence_is_a_typed_failure \.\.\. FAILED'
RUN='cargo test -p pod-egress --all-features --test shadowsocks_2022 -- a_shadowsocks_road_is_a_dialer_and_a_silence_is_a_typed_failure'
