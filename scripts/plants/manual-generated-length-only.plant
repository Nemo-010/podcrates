# pod-manual: the drift check of a generated file compares only the lengths, so a changed man page of the same length passes; its test must fail.
ENTRY=T-700
GROUP=manual
EXPECT='test check::tests::a_generated_file_must_equal_the_model \.\.\. FAILED'
RUN='cargo test -p pod-manual --lib -- check::tests::a_generated_file_must_equal_the_model --exact'
