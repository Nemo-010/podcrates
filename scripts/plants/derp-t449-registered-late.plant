# podssh T-449: the DERP stand-in answers a client 200 ms before it registers
# the client's key, so a cut of that key right after the answer finds no
# client: the node never moves, and the test of a node whose home went away
# waits its whole 180 s and fails.
ENTRY=T-031
GROUP=derp
EXPECT='test a_node_whose_home_went_away_moves_and_a_client_of_the_old_ticket_finds_it \.\.\. FAILED'
RUN='cargo test --no-fail-fast -p pod-derp --all-features --test derp_link -- a_node_whose_home_went_away_moves_and_a_client_of_the_old_ticket_finds_it'
