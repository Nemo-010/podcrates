# A credential with a space goes into the URL unchecked: the test must see
# a dial and a tunnel where it wants a refusal before any dial.
ENTRY=T-035
GROUP=egress
EXPECT='test an_eice_credential_that_cannot_go_in_a_url_is_refused_before_a_dial \.\.\. FAILED'
RUN='cargo test -p pod-egress --all-features --test eice -- an_eice_credential_that_cannot_go_in_a_url_is_refused_before_a_dial'
