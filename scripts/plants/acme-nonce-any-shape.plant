# A Replay-Nonce of any shape is taken, and goes into the JSON of the next
# request as it is; the test of the nonce's shape must fail.
ENTRY=T-034
GROUP=acme
EXPECT='test client::tests::pebbles_bad_nonce_is_known_and_a_nonce_of_another_shape_is_not_taken \.\.\. FAILED'
RUN='cargo test -p pod-acme --lib -- client::tests::pebbles_bad_nonce_is_known_and_a_nonce_of_another_shape_is_not_taken --exact'
